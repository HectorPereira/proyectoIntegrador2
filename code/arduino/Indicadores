    servo_hombro(90);
    servo_codo(90);
    servo_pinza(90);

    uint8_t manual_prev = 255;

    while (1){
        check_serial_mode();

        uint8_t manual;
        if (modo_serial == 1) manual = 1;
        else if (modo_serial == 2) manual = 0;
        else manual = is_manual_mode();

